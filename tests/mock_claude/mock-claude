#!/bin/sh
# Stand-in for claude: replays a scenario of timed steps in a pane.
#
# The e2e tests run this instead of claude, so they exercise real tmux, real
# panes and real `amx _hook` calls with no API key and no network. It is a
# shell script so that it shares no code with amx.
#
# Steps, one per line. Blank lines and `#` comments are ignored.
#
#   argv                  print the arguments this stand-in was given.
#   hook <Event> <json>   send a hook payload on `amx _hook`'s stdin. `<json>`
#                         is optional; `session_id` and `transcript_path` are
#                         added unless it names them.
#   print <text>          print a line, with backslash escapes.
#   sleep <ms>            wait. A long trailing sleep keeps the agent alive.
#   await <Key>           block until the key is typed at the pane. Only
#                         `Escape` (byte 27) is known.
#   transcript <json>     append a line to the transcript the hooks named.
#   ignore <signal>       ignore this signal, for an agent that will not stop.
#   exit <code>           exit with this code.
#
# @SESSION@, @SESSION2@, @TRANSCRIPT@ and @TRANSCRIPT2@ are substituted when
# the scenario is read. @NOW@ is substituted as each transcript line is written.
#
# Environment:
#   MOCK_CLAUDE_SCENARIO      the scenario to replay (required)
#   MOCK_CLAUDE_SESSION       the session id it announces
#   MOCK_CLAUDE_SESSION_2     the id a resumed session announces
#   MOCK_CLAUDE_TRANSCRIPT    the transcript it writes
#   MOCK_CLAUDE_TRANSCRIPT_2  the transcript a resumed session writes
#   AMX_BIN                   the amx that hooks are delivered to
#   AMX_ID                    inherited from the pane, read by `amx _hook`

set -u

scenario=${MOCK_CLAUDE_SCENARIO:-}
if [ -z "$scenario" ]; then
	echo "mock-claude: \$MOCK_CLAUDE_SCENARIO names the scenario to replay" >&2
	exit 64
fi
if [ ! -r "$scenario" ]; then
	echo "mock-claude: cannot read the scenario $scenario" >&2
	exit 66
fi

amx=${AMX_BIN:-amx}
session=${MOCK_CLAUDE_SESSION:-6f1c9f4e-0d5b-4a51-9f6e-2b1f0c3d4e5a}
session2=${MOCK_CLAUDE_SESSION_2:-b7d2a5c8-3e14-4f9a-8c26-0d5b1a7e3f42}
transcript=${MOCK_CLAUDE_TRANSCRIPT:-${TMPDIR:-/tmp}/mock-claude-$$.jsonl}
transcript2=${MOCK_CLAUDE_TRANSCRIPT_2:-$transcript.2}

# Deliver one hook as claude does: the payload on stdin, the agent in the env.
deliver() {
	event=${1%% *}
	json=${1#"$event"}
	json=${json# }
	[ -n "$json" ] || json='{}'

	fields="\"hook_event_name\":\"$event\""
	case "$json" in
	*'"session_id"'*) ;;
	*) fields="$fields,\"session_id\":\"$session\"" ;;
	esac
	case "$json" in
	*'"transcript_path"'*)
		# The payload moves the transcript; later `transcript` steps follow it.
		transcript=$(printf '%s' "$json" |
			sed -n 's/.*"transcript_path"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
		;;
	*) fields="$fields,\"transcript_path\":\"$transcript\"" ;;
	esac

	interior=$(printf '%s' "$json" |
		sed -e 's/^[[:space:]]*{[[:space:]]*//' -e 's/[[:space:]]*}[[:space:]]*$//')
	[ -z "$interior" ] || fields="$fields,$interior"

	printf '%s' "{$fields}" | "$amx" _hook
}

# Sleep for $1 milliseconds.
nap() {
	[ "$1" -gt 0 ] || return 0
	sleep "$(($1 / 1000)).$(printf '%03d' "$(($1 % 1000))")"
}

# The byte a terminal sends for a named key.
byte_of() {
	case "$1" in
	Escape) printf '27' ;;
	*) return 1 ;;
	esac
}

# Block until the key's byte arrives on stdin, or stdin closes.
#
# The terminal is put in non-canonical, no-echo mode, as claude reads keys.
# Bytes before the key, such as a message sent to the agent, are dropped.
# EOF also returns, so a pane whose terminal is gone does not hold the test.
await() {
	want=$(byte_of "$1") || {
		echo "mock-claude: $scenario: no key called \`$1\`" >&2
		exit 65
	}

	if [ -t 0 ]; then
		before=$(stty -g)
		stty -icanon -echo min 1 time 0
	fi
	while :; do
		typed=$(dd bs=1 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n')
		[ -n "$typed" ] || break
		[ "$typed" = "$want" ] && break
	done
	if [ -t 0 ]; then
		stty "$before"
	fi
}

# claude's transcript timestamp: ISO-8601 UTC to the millisecond. `%3N` is GNU
# date; where it comes back literal, fall back to `.000`.
now() {
	stamp=$(date -u +%Y-%m-%dT%H:%M:%S.%3NZ 2>/dev/null)
	case $stamp in
	*'%3N'* | '') stamp=$(date -u +%Y-%m-%dT%H:%M:%S.000Z) ;;
	esac
	printf '%s' "$stamp"
}

steps=$(mktemp "${TMPDIR:-/tmp}/mock-claude-steps.XXXXXX")
sed -e "s|@TRANSCRIPT2@|$transcript2|g" \
	-e "s|@TRANSCRIPT@|$transcript|g" \
	-e "s|@SESSION2@|$session2|g" \
	-e "s|@SESSION@|$session|g" \
	"$scenario" >"$steps"

# Steps are read on fd 3 so that stdin stays the pane's, where `await` reads
# keys. The file is unlinked once open instead of removed by an EXIT trap. An
# EXIT trap makes bash 5.3 catch SIGHUP, and a hangup landing in a command
# substitution then runs the trap there and spins forever.
exec 3<"$steps"
rm -f "$steps"

while IFS= read -r line <&3 || [ -n "$line" ]; do
	case "$line" in
	'' | '#'*) continue ;;
	esac
	verb=${line%% *}
	rest=${line#"$verb"}
	rest=${rest# }

	case "$verb" in
	argv) printf 'argv: %s\n' "$*" ;;
	hook) deliver "$rest" ;;
	print) printf '%b\n' "$rest" ;;
	sleep) nap "$rest" ;;
	await) await "$rest" ;;
	ignore) trap '' "$rest" ;;
	transcript)
		mkdir -p "$(dirname "$transcript")"
		printf '%s\n' "$(printf '%s' "$rest" | sed "s|@NOW@|$(now)|g")" >>"$transcript"
		;;
	exit) exit "$rest" ;;
	*)
		echo "mock-claude: $scenario: no step called \`$verb\`" >&2
		exit 65
		;;
	esac
done

exit 0
