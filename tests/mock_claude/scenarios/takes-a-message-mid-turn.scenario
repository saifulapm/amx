# A running turn that takes a queued message only when it finishes: the second
# UserPromptSubmit, four seconds on, marks the message going in.
hook SessionStart {"source": "startup"}
hook UserPromptSubmit {"prompt": "run the tests"}
print working on it
sleep 4000
hook UserPromptSubmit {"prompt": "and the linter"}
print on the linter
sleep 600000
