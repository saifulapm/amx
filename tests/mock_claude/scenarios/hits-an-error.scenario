# A turn an API error ends: StopFailure naming overloaded, and the prompt.
hook SessionStart {"source": "startup"}
hook UserPromptSubmit {"prompt": "port the importer"}
print   ⎿  API Error: 529 Overloaded
hook StopFailure {"error": "overloaded", "error_details": "529", "last_assistant_message": "API Error: 529 Overloaded"}
print ❯
print   ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents
sleep 600000
