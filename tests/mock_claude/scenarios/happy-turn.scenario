# A turn as claude runs one: a prompt, a tool call, an answer, then idle at its
# prompt.
hook SessionStart {"source": "startup"}
print I'll run the tests.
hook UserPromptSubmit {"prompt": "run the tests"}
sleep 50
hook PreToolUse {"tool_name": "Bash", "tool_input": {"command": "cargo test"}}
print Running: cargo test
sleep 50
transcript {"type":"assistant","timestamp":"@NOW@","sessionId":"@SESSION@","message":{"content":[{"type":"text","text":"the tests pass now"}]}}
print the tests pass now
hook Stop {"last_assistant_message": "the tests pass now"}
# The idle screen: the composer and the mode footer under it, which the screen
# rules read once the hooks go quiet.
print ❯
print   Opus 5 (1M context) │ ◈ 2% │ mock-claude (amx/fix-login-a1b) │ ◖ xhigh
print   ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents
# The agent stays until the test ends it.
sleep 600000
