# A session claude names itself: the name arrives as an `ai-title` line in the
# transcript under the hooks' session id, the only place claude writes it.
hook SessionStart {"source": "startup"}
hook UserPromptSubmit {"prompt": "fix the login bug"}
transcript {"type":"ai-title","aiTitle":"Login bug in the session cookie","sessionId":"@SESSION@"}
print the cookie is set on the right domain now
hook Stop {"last_assistant_message": "the cookie is set on the right domain now"}
print   ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents
sleep 600000
