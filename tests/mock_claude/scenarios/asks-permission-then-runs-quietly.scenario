# A permission box answered at the keyboard, whose tool then runs for a long
# time with no hook: claude fires nothing until PostToolUse, so only the
# screen says the box is gone.
hook SessionStart {"source": "startup"}
hook UserPromptSubmit {"prompt": "remove the build directory"}
sleep 50
hook PermissionRequest {"tool_name": "Bash"}
print ────────────────────────────────────────────────
print  Bash command
print    rm -rf build
print  Do you want to proceed?
print  ❯ 1. Yes
print    2. No
print  Esc to cancel · Tab to amend · ctrl+e to explain
hook Notification {"message": "Claude needs your permission to use Bash", "notification_type": "permission_prompt"}
await 1
print \033[2J\033[H
print ✽ Removing… (3s · ↓ 120 tokens)
print ──────────────────────────────────────────────
print ❯ 
print ──────────────────────────────────────────────
print   Opus 5 │ build (main) │ xhigh
print   ⏵⏵ accept edits on (shift+tab to cycle)
sleep 600000
