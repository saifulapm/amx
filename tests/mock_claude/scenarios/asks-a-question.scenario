# An agent stopped on a permission question, waiting for an answer.
hook SessionStart {"source": "startup"}
hook UserPromptSubmit {"prompt": "remove the build directory"}
sleep 50
hook Notification {"message": "Claude needs your permission to use Bash"}
# The permission box as claude draws it: a full-width rule, the request under
# it, and no mode footer below.
print ────────────────────────────────────────────────
print  Bash command
print    rm -rf build
print  Do you want to proceed?
print  ❯ 1. Yes
print    2. No
print  Esc to cancel · Tab to amend · ctrl+e to explain
sleep 600000
