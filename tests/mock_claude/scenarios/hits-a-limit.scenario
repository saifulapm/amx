# A turn a usage limit ends, as claude 2.1.325 ends one: a synthetic
# transcript entry with the limit's words, StopFailure naming rate_limit, then
# the Stop that follows it with the same words, and the prompt under them.
hook SessionStart {"source": "startup"}
hook UserPromptSubmit {"prompt": "port the importer"}
hook PreToolUse {"tool_name": "Bash", "tool_input": {"command": "cargo test"}}
transcript {"type":"assistant","timestamp":"@NOW@","sessionId":"@SESSION@","message":{"model":"<synthetic>","role":"assistant","stop_reason":"stop_sequence","content":[{"type":"text","text":"You have hit your limit · resets 3pm"}]},"error":"rate_limit","isApiErrorMessage":true}
print   ⎿  You have hit your limit · resets 3pm
hook StopFailure {"error": "rate_limit", "error_details": "", "last_assistant_message": "You have hit your limit · resets 3pm"}
hook Stop {"last_assistant_message": "You have hit your limit · resets 3pm"}
print ❯
print   ⏵⏵ auto mode on (shift+tab to cycle) · ← for agents
sleep 600000
