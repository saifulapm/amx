# One turn with a shell call and the answer at its end, as in
# tests/opencode/events/turn.jsonl.
screen idle
hook session.selected
hook session.execution.started
screen working
hook session.tool.called {"tool_name":"shell","tool_input":{"command":"sleep 40"}}
sleep 200
messages turn
hook session.execution.ended {"stop_reason":"stop","last_assistant_message":"done"}
screen idle-after
sleep 60000
