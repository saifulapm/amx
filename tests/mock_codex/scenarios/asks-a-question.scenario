# A turn that calls request_user_input: a PreToolUse naming the tool and its
# questions, then the question on the pane, waiting.
screen idle
sleep 50
hook SessionStart {}
hook UserPromptSubmit {}
screen working
sleep 50
hook PreToolUse {"tool_name":"request_user_input","tool_input":{"questions":[{"header":"Drink","id":"drink_choice","question":"Tea or coffee?","options":[{"label":"Tea","description":"Choose tea."},{"label":"Coffee","description":"Choose coffee."}]}]},"tool_use_id":"call-1"}
screen question
sleep 600000
