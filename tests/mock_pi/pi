#!/bin/sh
# Stand-in for pi: replays a scenario of timed steps in a pane.
#
# It is named `pi` and found on the PATH because amx keys its vendor table by
# the program an agent command runs; `--agent pi` with this directory first on
# the PATH drives pi's entry. It is a shell script so that it shares no code
# with amx.
#
# What it models:
#
#   listing         `--list-models` prints a header and one row per model,
#                   provider and id first, then exits. amx asks before there
#                   is a pane or a scenario.
#   session flags   `--session-id <id>` opens the session kept under that id,
#                   creating it if absent. `--fork <origin> --session-id <new>`
#                   copies the first into the second. `--session-id` beside one
#                   of the five flags pi refuses it with exits, as pi does.
#                   Beside `--no-session` the run goes ahead and the id is
#                   discarded.
#   screens         the screens `assets/screen-rules-pi.toml` was measured
#                   off, each painted as a full repaint in one write. The rules
#                   read the bottom of a capture, so a screen must never show
#                   half drawn or with the previous one above it.
#
# The argv and the session outcome are printed before the first repaint and
# stay in the pane's history, where `capture-pane -S -` reads them. Reports
# come only from scenario steps.
#
# Steps, one per line. Blank lines and `#` comments are ignored.
#
#   screen <name>   repaint with one of pi's screens:
#                     boot            a fresh pi nobody has typed into
#                     notice          boot with the Update Available box
#                     notice-working  a turn running under that box
#                     working         frame and word in the box's top border
#                     compacting      the compaction row above the box
#                     retrying        the retry row above the box
#                     renamed         an extension's message in the border
#                     dialog          a question replacing the composer
#                     input, editor   asking for a line, a block of text
#                     trust           the folder-trust question
#                     setup           the first-run gate, before any pane
#                     login           asking for a provider's key
#                     selector        a pi selector in the composer's slot
#                     scrolled        the same under a transcript
#                     idle            the prompt after a finished turn
#                     wordless        the prompt after a turn with no prose
#   sleep <ms>      wait. A long trailing sleep keeps the agent alive.
#   hook <event> <json>
#                   report as amx's pi extension does: the payload on
#                   `amx _hook`'s stdin under pi's event name, with the session
#                   id and session file added unless named. The hook's answer,
#                   the record directory, is kept and not printed.
#   transcript <json>
#                   append a line to the session file, which amx reads the
#                   conversation from.
#   live <text>     write `live` whole in the last answered record directory,
#                   via rename, as the extension streams. Bare `live` removes
#                   it. Nothing is written before a report was answered.
#   heartbeat       touch `heartbeat` in that directory, as the extension does
#                   while a turn runs; only its mtime matters. `heartbeat off`
#                   removes it, as when the turn settles.
#
# Environment:
#   MOCK_PI_SCENARIO   the scenario to replay (required except for listing)

set -u

# The listing comes before the scenario check: amx asks for it to decide which
# harness a typed model belongs to, with no pane yet. Real pi prints about 490
# rows; two show the shape.
for arg do
	[ "$arg" = "--list-models" ] || continue
	cat <<'LISTING'
PROVIDER        MODEL         CONTEXT
github-copilot  gpt-5-mini    264k
cerebras        qwen-3-coder  131k
LISTING
	exit 0
done

scenario=${MOCK_PI_SCENARIO:-}
if [ -z "$scenario" ]; then
	echo "mock pi: \$MOCK_PI_SCENARIO names the scenario to replay" >&2
	exit 64
fi
if [ ! -r "$scenario" ]; then
	echo "mock pi: cannot read the scenario $scenario" >&2
	exit 66
fi

sessions=$HOME/.pi/sessions

# The five flags pi refuses `--session-id` beside. amx's entry also displaces
# `--no-session`, but pi accepts that one silently and keeps the conversation
# in memory, so the stand-in does too.
REFUSES="-c -r --continue --resume --session"

printf 'argv: %s\n' "$*"

# `--session-id <id>` and `--fork <origin>` are two words each; pi reads no
# `=` spelling of either.
session=
# The record directory the last report was answered with.
record=
origin=
clash=
in_memory=
value_of=
# A word starting with `@` names a file to attach, before or after `--`, since
# `--` ends pi's flags and not its file arguments (dist/cli/args.js:23-31 and
# :224, pi 0.87.1). A missing file ends pi.
attaches() {
	case $1 in
	@*)
		[ -e "${1#@}" ] && return
		echo "Error: File not found: $PWD/${1#@}" >&2
		exit 1
		;;
	esac
}
ended=
for arg do
	if [ -n "$ended" ]; then
		attaches "$arg"
		continue
	fi
	case $value_of in
	session)
		session=$arg
		value_of=
		continue
		;;
	fork)
		origin=$arg
		value_of=
		continue
		;;
	esac
	case $arg in
	--session-id) value_of=session ;;
	--fork) value_of=fork ;;
	--no-session) in_memory=yes ;;
	--) ended=yes ;;
	@*) attaches "$arg" ;;
	*)
		case " $REFUSES " in
		*" $arg "*) clash=$arg ;;
		esac
		;;
	esac
done

if [ -n "$clash" ] && [ -n "$session" ]; then
	echo "mock pi: --session-id cannot be combined with $clash" >&2
	exit 2
fi

if [ -n "$in_memory" ]; then
	# pi checks this before writing a session, so the id is accepted and no
	# file is written. amx's `conflicts` list keeps a minted id out of this run.
	:
elif [ -n "$origin" ]; then
	if [ -z "$session" ]; then
		echo "mock pi: --fork $origin names no id to branch into" >&2
		exit 2
	fi
	from=$sessions/$origin.jsonl
	if [ ! -f "$from" ]; then
		echo "mock pi: no session with id $origin" >&2
		exit 1
	fi
	if [ -f "$sessions/$session.jsonl" ]; then
		echo "mock pi: Session already exists with id $session" >&2
		exit 1
	fi
	mkdir -p "$sessions"
	cp "$from" "$sessions/$session.jsonl"
	printf 'session: branched %s from %s\n' "$session" "$origin"
elif [ -n "$session" ]; then
	if [ -f "$sessions/$session.jsonl" ]; then
		printf 'session: opened %s\n' "$session"
	else
		mkdir -p "$sessions"
		: >"$sessions/$session.jsonl"
		printf 'session: created %s\n' "$session"
	fi
fi

# ── The screens ──────────────────────────────────────────────────────────────
# Trimmed from the captures in `assets/screen-rules-pi.toml`, taken off pi
# 0.84.4. Two things are drawn rather than copied: the box is as wide as the
# pane, as pi draws it, and the stats line is cut to 80 columns from the 100 it
# was captured at. pi truncates that line from the right, and the anchors sit
# at its start.

width=$( (stty size </dev/tty) 2>/dev/null | cut -d' ' -f2 )
case $width in
'' | *[!0-9]*) width=80 ;;
esac
border=
column=0
while [ "$column" -lt "$width" ]; do
	border=$border─
	column=$((column + 1))
done

# The working directory, the first of pi's two footer rows.
here=$PWD
case $here in
"$HOME"*) here="~${here#"$HOME"}" ;;
esac

# Cursor home and clear, which opens every repaint.
CLEAR=$(printf '\033[H\033[2J')

# The stats lines measured: a subscription session before its first turn,
# after a turn, and on a pi with no provider (the login screen's).
FRESH='$0.000 (sub) 0.0%/264k (auto)              (github-copilot) gpt-5-mini • minimal'
TURNED='↑1.5k ↓69 R1.3k CH90.3% $0.001 (sub) 0.5%/264k (auto)   (github-copilot)'
UNSET='0.0%/0 (auto)                                                        unknown'

# The functions below print a screen for `draw` to capture and write in one go.
#
# The composer box and the footer under it. `$1` is the stats line, the one
# part of the chrome that differs before and after a first turn.
box() {
	printf '%s\n\n%s\n%s\n%s\n' "$border" "$border" "$here" "$1"
}

boot() {
	printf ' pi v0.84.4\n'
	printf ' escape interrupt · ctrl+c/ctrl+d clear/exit · / commands · ! bash · ctrl+o more\n'
	printf ' Press ctrl+o to show full startup help and loaded resources.\n\n'
	printf ' Pi can explain its own features and look up its docs.\n\n\n'
	box "$FRESH"
}

# The box pi draws above its composer when a newer pi exists, measured on
# 0.84.4 with 0.85.1 out at 120x40, 100x30, 80x24 and 40x24: a border, the
# title, the instruction, the changelog line, a border, one blank row, then the
# composer. Its borders are the composer's own glyphs. A release note, when
# there is one, goes between the instruction and the changelog with a blank
# row either side.
update_box() {
	printf '%s\n' "$border"
	printf ' Update Available\n'
	printf ' New version 0.85.1 is available. Run pi update\n'
	printf ' Changelog: https://pi.dev/changelog\n'
	printf '%s\n\n' "$border"
}

# A fresh pi with the update box: the boot rows, the box, the composer.
notice() {
	printf ' pi v0.84.4\n'
	printf ' escape interrupt · ctrl+c/ctrl+d clear/exit · / commands · ! bash · ctrl+o more\n'
	printf ' Press ctrl+o to show full startup help and loaded resources.\n\n'
	printf ' Pi can explain its own features and look up its docs.\n\n\n'
	update_box
	box "$FRESH"
}

# A turn running under the update box, measured at 100x30 on 0.84.4: the
# prompt two rows under the box, then the composer with the frame and word in
# its top border, where 0.85.1 draws them.
notice_working() {
	printf ' pi v0.84.4\n'
	printf ' escape interrupt · ctrl+c/ctrl+d clear/exit · / commands · ! bash · ctrl+o more\n'
	printf ' Press ctrl+o to show full startup help and loaded resources.\n\n'
	printf ' Pi can explain its own features and look up its docs.\n\n\n'
	update_box
	printf '\n Run this exact bash command and nothing else: echo hi\n\n\n'
	working_box '⠦' 'Working' "$FRESH"
}

# The composer with the working indicator in its top border, as pi 0.85.1
# draws it: `── `, the frame, the message, a space, and the rule to the pane's
# edge, with no status row above. Measured at 100, 54, 40, 30, 24 and 20
# columns; at 20 the rule after the message is seven wide and the bottom
# border is the twenty the spinner rule needs. `$1` is the frame, `$2` the
# message, `$3` the stats line.
working_box() {
	lead="── $1 $2 "
	rule=
	column=$((${#2} + 6))
	while [ "$column" -lt "$width" ]; do
		rule=$rule─
		column=$((column + 1))
	done
	printf '%s%s\n\n%s\n%s\n%s\n' "$lead" "$rule" "$border" "$here" "$3"
}

# A running turn: the prompt, and the frame and word in the box's top border.
working() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	working_box '⠼' 'Working' "$TURNED"
}

# pi's other three running indicators. pi shows one of four kinds at a time.
# Only the working kind is drawn in the border; `/compact` and a retry replace
# it with their own row above the box, a blank row between, so `Working` is
# gone for their duration. `ctx.ui.setWorkingMessage` replaces the word with
# the extension's message. The frame before the message stays, and each screen
# uses a different one of the ten since pi cycles them. Measured at 100
# columns: compacting against a provider that never answered, retrying against
# one answering 503, renamed against an extension setting its message on
# session start. The row positions and the border placement come from 0.85.1's
# source, not a live run.
compacting() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠴ Compacting context... (escape to cancel)\n\n'
	box "$TURNED"
}

retrying() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠋ Retrying (1/3) in 2s... (escape to cancel)\n\n'
	box "$TURNED"
}

renamed() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	working_box '⠧' 'Reviewing the diff' "$FRESH"
}

idle() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n'
	printf ' $ echo hi (timeout 10s)\n\n hi\n\n Took 15.2s\n\n'
	box "$TURNED"
}

# The prompt after a turn the model answered with no prose. pi draws an answer
# with no glyph, label or colour, in the same column as the model's thinking,
# so the pane shows the previous turn's tail, this turn's tool call and the
# thinking, and none of it is an answer. The rules read it as `idle`; a reader
# of the rows must not take it as the answer.
#
# The turn `docs/pi-screens.md` drove at 100 columns, with its lines cut to fit
# 80 like the stats line. The words are the model's; the layout is pi's.
wordless() {
	printf ' Took 15.2s\n\n\n'
	printf ' Now run: sleep 25; echo finished  with the bash tool. Say nothing else.\n\n\n'
	printf ' $ sleep 25; echo finished (timeout 35s)\n\n finished\n\n Took 25.0s\n\n'
	printf ' Following the instruction to say nothing after the tool completes.\n\n'
	printf ' Analyzing the post-tool turn to confirm nothing more is wanted.\n\n'
	box "$TURNED"
}

# pi blocked on a dialog raised while gating a tool call. The turn is still
# running but nothing spins: 0.85.1 draws the working indicator in the editor,
# and the dialog replaces the editor. The borders, working directory and stats
# line stay as on any other screen. Measured at 100 and 20 columns with an
# extension gating the bash tool through `ctx.ui.select`.
dialog() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf '%s\n\n Run echo hi?\n\n → Allow once\n   Allow always\n   Deny\n\n ↑↓ navigate  enter select  escape/ctrl+c cancel\n\n%s\n%s\n%s\n' \
		"$border" "$border" "$here" "$TURNED"
}

# The other two blocking prompts, drawn where the dialog is, with the same
# footer. `ctx.ui.input` asks for a line and draws the input row between the
# title and the hint row; `ctx.ui.editor` asks for a block and draws a second
# box there. Both hint rows start `enter submit`; the editor's also names the
# newline key, which tells them apart. Measured at 100 columns, raised by an
# extension with no turn running.
input() {
	printf '%s\n\n Which branch should I push to?\n\n>\n\n enter submit  escape/ctrl+c cancel\n\n%s\n%s\n%s\n' \
		"$border" "$border" "$here" "$FRESH"
}

editor() {
	printf '%s\n\n Write the commit message\n\n%s\n\n%s\n\n enter submit  shift+enter/ctrl+j newline  escape/ctrl+c cancel  ctrl+g external editor\n\n%s\n%s\n%s\n' \
		"$border" "$border" "$border" "$border" "$here" "$FRESH"
}

# pi asking whether to trust this folder. Same box and hint row as the dialog;
# two rows tell them apart: the title `Project trust`, on no other pi screen,
# and a hint row reading `enter save` where a gated tool call reads `enter
# select`. `/trust` raises it with no turn running, so there is no spinner and
# the stats line is a fresh session's.
#
# The folder is written in full under the title and abbreviated in the footer,
# which is why `within` has to allow for a wrapped row. Measured at 100
# columns on a worktree pi had no saved decision for.
trust() {
	printf '%s\n\n Project trust\n %s\n\n Saved decision: none\n Current session: trusted\n\n → Trust\n   Trust parent folder (%s)\n   Do not trust\n\n ↑↓ navigate  enter save  escape/ctrl+c cancel\n\n%s\n%s\n%s\n' \
		"$border" "$PWD" "${PWD%/*}" "$border" "$here" "$FRESH"
}

# The first-run gate: with no settings.json in the agent directory, pi asks for
# a theme and then about analytics before drawing a session pane. It is its
# own TUI, with no composer, working directory or stats line, drawn at the top
# of the pane. The theme step comes first; the banner is on both steps.
#
# Measured at 100 columns with PI_EXPERIMENTAL=1 and an empty agent directory,
# which is what makes pi draw it.
setup() {
	printf '%s\n\n ██████\n ██  ██\n ████  ██\n ██    ██\n\n' "$border"
	printf ' Welcome to pi, the minimal coding agent.\n\n'
	printf ' Pick a theme.\n Detected system appearance: dark\n\n'
	printf ' → Dark\n   Light\n\n'
	printf ' ↑↓ navigate  enter continue  escape/ctrl+c skip setup\n\n%s\n' "$border"
}

# pi asking for a provider's API key, where `/login` ends for any provider not
# signed into with an account. The dialog takes the editor's slot with the
# same footer; its title sits directly under the top border, with no blank row.
#
# Measured at 100 columns on a pi with no provider configured, as a spawned
# agent nobody logged in has, so pi's warning is above the box and the stats
# line says `unknown` for the model.
login() {
	printf ' Warning: No models available. Use /login to log into a provider via OAuth\n or API key. See:\n\n'
	printf '%s\n Login to Cerebras\n\n Enter Cerebras API key\n>\n (escape/ctrl+c to cancel, enter to submit)\n%s\n%s\n%s\n' \
		"$border" "$border" "$here" "$UNSET"
}

# One of pi's own selectors in the composer's slot. These two screens test a
# shape and a distance: a widget between the composer's borders with the
# footer under it, and how far the last rule in the document reaches.
#
# Measured at 100 columns with the show-images selector, the shortest box pi
# puts there, raised through `ctx.ui.custom`. With nothing above it, five rows
# separate its top border from the stats line. Under a transcript it is seven,
# because `!seq 1 60` leaves its own box's bottom border on the pane and the
# rules read the topmost border they see.
selector() {
	printf ' pi v0.84.4\n'
	printf ' escape interrupt · ctrl+c/ctrl+d clear/exit · / commands · ! bash · ctrl+o more\n'
	printf ' Press ctrl+o to show full startup help and loaded resources.\n\n'
	printf ' Pi can explain its own features and look up its docs.\n\n\n'
	printf '%s\n  Yes         Show images inline in terminal\n→ No          Show text placeholder instead\n%s\n%s\n%s\n' \
		"$border" "$border" "$here" "$FRESH"
}

scrolled() {
	printf ' 58\n 59\n 60\n\n\n ... 41 more lines (ctrl+o to expand)\n'
	printf '%s\n\n%s\n  Yes         Show images inline in terminal\n→ No          Show text placeholder instead\n%s\n%s\n%s\n' \
		"$border" "$border" "$border" "$here" "$FRESH"
}

# Repaint as a full-screen program does; the old screen goes into the pane's
# history.
#
# The clear and every row go out in one write. A repaint split in two shows a
# screen pi never draws, such as an empty pane or a spinner row with no box.
# The screen is built first and written with `cat`, since the shell's printf
# splits a screen this size often enough to see: over about 12,000 captures,
# 374 were torn with several printfs, 41 with one printf, and 2 with the
# heredoc below (the terminal splitting one write).
draw() {
	case $1 in
	boot) screen=$(boot) ;;
	notice) screen=$(notice) ;;
	notice-working) screen=$(notice_working) ;;
	working) screen=$(working) ;;
	compacting) screen=$(compacting) ;;
	retrying) screen=$(retrying) ;;
	renamed) screen=$(renamed) ;;
	idle) screen=$(idle) ;;
	wordless) screen=$(wordless) ;;
	dialog) screen=$(dialog) ;;
	input) screen=$(input) ;;
	editor) screen=$(editor) ;;
	trust) screen=$(trust) ;;
	setup) screen=$(setup) ;;
	login) screen=$(login) ;;
	selector) screen=$(selector) ;;
	scrolled) screen=$(scrolled) ;;
	*)
		echo "mock pi: $scenario: no screen called \`$1\`" >&2
		exit 65
		;;
	esac
	cat <<EOF
$CLEAR$screen
EOF
}

# Sleep for $1 milliseconds.
nap() {
	[ "$1" -gt 0 ] || return 0
	sleep "$(($1 / 1000)).$(printf '%03d' "$(($1 % 1000))")"
}

# Report one event as amx's pi extension does: the payload on `amx _hook`'s
# stdin under pi's event name, with the session id and its file, which is the
# transcript amx reads. `AMX_BIN` and `AMX_ID` come from the pane's env.
deliver() {
	event=${1%% *}
	json=${1#"$event"}
	json=${json# }
	[ -n "$json" ] || json='{}'

	fields="\"hook_event_name\":\"$event\""
	case "$json" in
	*'"session_id"'*) ;;
	*) [ -z "$session" ] || fields="$fields,\"session_id\":\"$session\"" ;;
	esac
	case "$json" in
	*'"transcript_path"'*) ;;
	*) [ -z "$session" ] || fields="$fields,\"transcript_path\":\"$sessions/$session.jsonl\"" ;;
	esac

	interior=$(printf '%s' "$json" |
		sed -e 's/^[[:space:]]*{[[:space:]]*//' -e 's/[[:space:]]*}[[:space:]]*$//')
	[ -z "$interior" ] || fields="$fields,$interior"

	[ -n "${AMX_BIN:-}" ] || return 0
	answer=$(printf '%s' "{$fields}" | "$AMX_BIN" _hook)
	[ -z "$answer" ] || record=$answer
}

# Write the streamed text beside the record, whole and renamed in so a reader
# never sees half of it. Empty text removes it.
say() {
	[ -n "$record" ] || return 0
	if [ -z "$1" ]; then
		rm -f "$record/live"
		return 0
	fi
	printf '%s' "$1" >"$record/live.tmp" && mv "$record/live.tmp" "$record/live"
}

# Touch the heartbeat beside the record, or remove it with `off`. The
# extension touches it every few seconds while a turn runs.
beat() {
	[ -n "$record" ] || return 0
	if [ "$1" = off ]; then
		rm -f "$record/heartbeat"
		return 0
	fi
	: >"$record/heartbeat"
}

# Append one line to the session file, as pi does during a turn.
transcribe() {
	[ -n "$session" ] || return 0
	mkdir -p "$sessions"
	printf '%s\n' "$1" >>"$sessions/$session.jsonl"
}

while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
	'' | '#'*) continue ;;
	esac
	verb=${line%% *}
	rest=${line#"$verb"}
	rest=${rest# }

	case "$verb" in
	screen) draw "$rest" ;;
	sleep) nap "$rest" ;;
	hook) deliver "$rest" ;;
	transcript) transcribe "$rest" ;;
	live) say "$rest" ;;
	heartbeat) beat "$rest" ;;
	*)
		echo "mock pi: $scenario: no step called \`$verb\`" >&2
		exit 65
		;;
	esac
done <"$scenario"

exit 0
