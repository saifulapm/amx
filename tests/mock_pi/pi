#!/bin/sh
# A stand-in for pi, replaying a scenario of timed steps.
#
# It is called `pi`, and reached through the PATH, because that is the whole of
# what makes it pi: amx keys its vendor table by the program an agent command
# runs, so this directory in front of the PATH and `--agent pi` is the only way
# to drive pi's entry on a machine with no pi on it. mock-claude next door is
# the opposite fixture — a command the table has no entry for — and both are
# shell scripts for the same reason: what is under test is amx's handling of a
# foreign program in the pane, and a fixture sharing amx's own code would only
# ever prove that amx agrees with itself.
#
# It answers for two of the things pi's entry claims, and for nothing else:
#
#   the session flags   `--session-id <id>` opens the session already kept
#                       under that id and creates one under it when there is
#                       none, and `--fork <origin> --session-id <new>` branches
#                       the first into the second. A `--session-id` written
#                       beside one of the five flags pi refuses it next to ends
#                       this the way it ends pi: an exit, not a warning. Beside
#                       `--no-session`, which pi refuses nothing over, the run
#                       goes ahead and the id is thrown away.
#   the screens         the screens `assets/screen-rules-pi.toml` was measured
#                       off, drawn by repainting the pane rather than
#                       appending to it, and each in one write. The rules read
#                       the bottom of a capture: a screen with the last one
#                       still above it is not a screen pi ever drew, and
#                       neither is half of one.
#
# How it was called, and what it did with the session it was handed, are
# written before the first repaint: they leave the screen with it and stay in
# the pane's history, which is where `capture-pane -S -` reads them. pi reports
# nothing through hooks, so a test has nowhere else to read either of them.
#
# Steps, one per line. Blank lines and `#` comments are ignored.
#
#   screen <name>   repaint the pane with one of pi's screens: `boot`, the pane
#                   of a pi nobody has typed into yet; `working`, with the line
#                   pi spins above its box; `compacting`, `retrying` and
#                   `renamed`, the same row with each of the other three things
#                   pi says on it; `dialog`, blocked on a question with the
#                   composer replaced; `input` and `editor`, blocked the same
#                   way on a line and on a block of text; `trust`, blocked on
#                   whether this folder is one to trust; and `idle`, the prompt
#                   a finished turn leaves behind.
#   sleep <ms>      wait. A long trailing sleep is how a scenario keeps its
#                   agent alive for the test driving it.
#
# Environment:
#   MOCK_PI_SCENARIO   the scenario to replay (required)

set -u

scenario=${MOCK_PI_SCENARIO:-}
if [ -z "$scenario" ]; then
	echo "mock pi: \$MOCK_PI_SCENARIO names the scenario to replay" >&2
	exit 64
fi
if [ ! -r "$scenario" ]; then
	echo "mock pi: cannot read the scenario $scenario" >&2
	exit 66
fi

sessions=$HOME/.pi/sessions

# The five flags pi exits rather than take `--session-id` beside. Its entry
# lists a sixth, `--no-session`, and that one is not here: pi takes the id
# under it and keeps the conversation in memory, writing no file and saying
# nothing about it. amx displaces all six, but only these five are a refusal,
# and a stand-in that refused where the vendor is silent would prove a test
# against a pi nobody can run.
REFUSES="-c -r --continue --resume --session"

printf 'argv: %s\n' "$*"

# `--session-id <id>` and `--fork <origin>` are two words each: `--help` shows
# them that way and nothing in pi reads a `=` spelling of either, so neither is
# read here.
session=
origin=
clash=
in_memory=
value_of=
for arg do
	case $value_of in
	session)
		session=$arg
		value_of=
		continue
		;;
	fork)
		origin=$arg
		value_of=
		continue
		;;
	esac
	case $arg in
	--session-id) value_of=session ;;
	--fork) value_of=fork ;;
	--no-session) in_memory=yes ;;
	*)
		case " $REFUSES " in
		*" $arg "*) clash=$arg ;;
		esac
		;;
	esac
done

if [ -n "$clash" ] && [ -n "$session" ]; then
	echo "mock pi: --session-id cannot be combined with $clash" >&2
	exit 2
fi

if [ -n "$in_memory" ]; then
	# pi reads this branch before the one that writes a session to disk, so the
	# id is taken and the conversation is kept in memory: no file under it, and
	# nothing said about one. This is the run amx's `conflicts` list exists to
	# keep a minted id out of.
	:
elif [ -n "$origin" ]; then
	if [ -z "$session" ]; then
		echo "mock pi: --fork $origin names no id to branch into" >&2
		exit 2
	fi
	from=$sessions/$origin.jsonl
	if [ ! -f "$from" ]; then
		echo "mock pi: no session with id $origin" >&2
		exit 1
	fi
	if [ -f "$sessions/$session.jsonl" ]; then
		echo "mock pi: Session already exists with id $session" >&2
		exit 1
	fi
	mkdir -p "$sessions"
	cp "$from" "$sessions/$session.jsonl"
	printf 'session: branched %s from %s\n' "$session" "$origin"
elif [ -n "$session" ]; then
	if [ -f "$sessions/$session.jsonl" ]; then
		printf 'session: opened %s\n' "$session"
	else
		mkdir -p "$sessions"
		: >"$sessions/$session.jsonl"
		printf 'session: created %s\n' "$session"
	fi
fi

# ── The screens ──────────────────────────────────────────────────────────────
# Trimmed from the captures in `assets/screen-rules-pi.toml`, which were read
# off pi 0.84.4 on 2026-09-04. Two things are drawn rather than copied. The box
# is as wide as the pane, which is what pi does and what makes twenty columns
# of border worth anchoring on; and the stats line is written to fit eighty
# columns rather than the hundred it was captured at, because pi truncates
# that line from the right and what a narrower pane keeps is its opening —
# which is where every anchor in the document sits.

width=$( (stty size </dev/tty) 2>/dev/null | cut -d' ' -f2 )
case $width in
'' | *[!0-9]*) width=80 ;;
esac
border=
column=0
while [ "$column" -lt "$width" ]; do
	border=$border─
	column=$((column + 1))
done

# Where pi says it is running, which is the first of its two footer rows.
here=$PWD
case $here in
"$HOME"*) here="~${here#"$HOME"}" ;;
esac

# The one piece of a repaint that is not a row: the cursor home and the pane
# emptied, which every screen opens with.
CLEAR=$(printf '\033[H\033[2J')

# The two stats lines measured: a subscription-backed session before its first
# turn, and one that has taken a turn.
FRESH='$0.000 (sub) 0.0%/264k (auto)              (github-copilot) gpt-5-mini • minimal'
TURNED='↑1.5k ↓69 R1.3k CH90.3% $0.001 (sub) 0.5%/264k (auto)   (github-copilot)'

# Each screen below is written to a pipe rather than to the pane: `draw` reads
# what it printed, adds the clear in front of it, and puts the whole screen on
# the pane in one write.
#
# The composer box and the footer under it, which every screen below ends with.
# `$1` is the stats line, because its opening is the one part of the chrome
# that differs between a session that has taken a turn and one that has not.
box() {
	printf '%s\n\n%s\n%s\n%s\n' "$border" "$border" "$here" "$1"
}

boot() {
	printf ' pi v0.84.4\n'
	printf ' escape interrupt · ctrl+c/ctrl+d clear/exit · / commands · ! bash · ctrl+o more\n'
	printf ' Press ctrl+o to show full startup help and loaded resources.\n\n'
	printf ' Pi can explain its own features and look up its docs.\n\n\n'
	box "$FRESH"
}

# The line pi spins sits two rows above the box's top border, with one blank
# row between them, and stays up for the whole turn.
working() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠼ Working...\n\n'
	box "$TURNED"
}

# The other three things pi puts on that row, drawn where `working` draws its
# own. pi has one status line and swaps out which of its four kinds is on it:
# `/compact` and a retry each take the working indicator down and put their own
# where it was, so `Working...` is off the pane for the whole of either, and
# `ctx.ui.setWorkingMessage` rewrites the message on the kind that is left.
# What none of them changes is the frame in front of the message or the row it
# is on. The frame is a different one of the ten on each screen below, because
# the vendor cycles them and no capture can say which one a pane is on.
# Measured at 100 columns on 2026-09-05 — the first two against a provider that
# never answered and one that answered 503 to everything, the third against an
# extension that set its own message on session start.
compacting() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠴ Compacting context... (escape to cancel)\n\n'
	box "$TURNED"
}

retrying() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠋ Retrying (1/3) in 2s... (escape to cancel)\n\n'
	box "$TURNED"
}

renamed() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠧ Reviewing the diff\n\n'
	box "$FRESH"
}

idle() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n'
	printf ' $ echo hi (timeout 10s)\n\n hi\n\n Took 15.2s\n\n'
	box "$TURNED"
}

# pi blocked on a dialog raised while gating a tool call: the turn is still
# running, so the line pi spins is up above the box exactly as it is on
# `working`, and inside the box the editor is replaced by the question and its
# choices. The two borders stay where they were, with the working directory
# and the stats line under them exactly as on any other screen. Measured at
# 100 columns with an extension gating the bash tool with `ctx.ui.select`.
dialog() {
	printf ' Run this exact bash command and nothing else: echo hi\n\n\n'
	printf ' ⠼ Working...\n\n'
	printf '%s\n\n Run echo hi?\n\n → Allow once\n   Allow always\n   Deny\n\n ↑↓ navigate  enter select  escape/ctrl+c cancel\n\n%s\n%s\n%s\n' \
		"$border" "$border" "$here" "$TURNED"
}

# The other two stops a caller puts pi on, drawn where the dialog above is and
# with the same footer under them. `ctx.ui.input` asks for one line, and pi
# draws the row it waits to be typed into between the title and the hint row;
# `ctx.ui.editor` asks for a block, and draws a second box there instead. Both
# hint rows open on `enter submit`, and the editor's says how to end a line as
# well, which is what tells the two apart. Nothing runs over either: an
# extension raised these with no turn under way, which is how they were
# measured at 100 columns on 2026-09-05.
input() {
	printf '%s\n\n Which branch should I push to?\n\n>\n\n enter submit  escape/ctrl+c cancel\n\n%s\n%s\n%s\n' \
		"$border" "$border" "$here" "$FRESH"
}

editor() {
	printf '%s\n\n Write the commit message\n\n%s\n\n%s\n\n enter submit  shift+enter/ctrl+j newline  escape/ctrl+c cancel  ctrl+g external editor\n\n%s\n%s\n%s\n' \
		"$border" "$border" "$border" "$border" "$here" "$FRESH"
}

# pi asking whether this folder is one to trust. The same box the dialog above
# is drawn in, ending in the same hint row, and two rows are what tell the two
# apart: the title `Project trust`, which no other screen pi draws carries, and
# a hint row that reads `enter save` where a gated tool call's reads `enter
# select`. Nothing is running under it — a person raises this with `/trust`
# rather than a tool call raising it mid-turn — so the line pi spins is not on
# this screen and the stats line is a session that has not taken a turn.
#
# The folder is written out in full on its own row under the title and
# abbreviated in the footer, which is pi's own inconsistency and the reason
# `within` has to allow for a row that wraps. Measured at 100 columns on
# 2026-09-05, on a worktree the vendor had nothing saved about.
trust() {
	printf '%s\n\n Project trust\n %s\n\n Saved decision: none\n Current session: trusted\n\n → Trust\n   Trust parent folder (%s)\n   Do not trust\n\n ↑↓ navigate  enter save  escape/ctrl+c cancel\n\n%s\n%s\n%s\n' \
		"$border" "$PWD" "${PWD%/*}" "$border" "$here" "$FRESH"
}

# Repaint, the way a program that owns its pane draws a new screen. What was
# there goes into the pane's history rather than above the new screen.
#
# The clear and every row leave in ONE write. A repaint that reaches the
# terminal in two pieces puts a screen on the pane pi never draws — an empty
# one between the clear and the first row, or the spinner line with no box
# under it — and whatever is reading the pane reads a pi that does not exist.
#
# So the screen is built first and written second, and it is written by `cat`
# rather than by `printf`. That is a measured choice, not a stylistic one: the
# shell's own printf hands a terminal a screen this size in two pieces often
# enough to see. Counted over ~12,000 captures of a pane repainting without a
# pause between screens: 374 torn captures when each screen was several
# printfs, 41 when it was one, and 2 through the heredoc below — and those two
# are the terminal dividing one write, which is not this script's to mend.
draw() {
	case $1 in
	boot) screen=$(boot) ;;
	working) screen=$(working) ;;
	compacting) screen=$(compacting) ;;
	retrying) screen=$(retrying) ;;
	renamed) screen=$(renamed) ;;
	idle) screen=$(idle) ;;
	dialog) screen=$(dialog) ;;
	input) screen=$(input) ;;
	editor) screen=$(editor) ;;
	trust) screen=$(trust) ;;
	*)
		echo "mock pi: $scenario: no screen called \`$1\`" >&2
		exit 65
		;;
	esac
	cat <<EOF
$CLEAR$screen
EOF
}

# Milliseconds, because a scenario's interesting waits are shorter than a
# second.
nap() {
	[ "$1" -gt 0 ] || return 0
	sleep "$(($1 / 1000)).$(printf '%03d' "$(($1 % 1000))")"
}

while IFS= read -r line || [ -n "$line" ]; do
	case "$line" in
	'' | '#'*) continue ;;
	esac
	verb=${line%% *}
	rest=${line#"$verb"}
	rest=${rest# }

	case "$verb" in
	screen) draw "$rest" ;;
	sleep) nap "$rest" ;;
	*)
		echo "mock pi: $scenario: no step called \`$verb\`" >&2
		exit 65
		;;
	esac
done <"$scenario"

exit 0
