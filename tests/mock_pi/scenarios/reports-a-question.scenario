# A turn stopped on an extension's question, reported as pi reports it: the
# prompt opening and later closing so the turn goes on. The dialog is on the
# pane while the prompt is open.
screen boot
hook session_start {}
sleep 50
hook agent_start {}
screen dialog
hook ui_prompt_start {"kind":"confirm","message":"Run echo hi?"}
sleep 4000
hook ui_prompt_end {"kind":"confirm"}
screen working
sleep 600000
