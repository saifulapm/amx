# A running turn that takes a steered message when it gets to it. pi starts no
# new agent for it; the user message_start three seconds on marks it going in.
screen boot
hook session_start {}
sleep 50
hook agent_start {}
transcript {"type":"message","id":"u1","parentId":null,"message":{"role":"user","content":"tell me about this","timestamp":1}}
screen working
sleep 3000
hook message_start {"role":"user"}
transcript {"type":"message","id":"u2","parentId":"u1","message":{"role":"user","content":"hi","timestamp":2}}
sleep 600000
