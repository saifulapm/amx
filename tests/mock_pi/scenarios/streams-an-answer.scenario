# A pi started by hand and taken over by `amx adopt`. With no AMX_DIR, the
# record directory comes back from the hook: it reports its session a few times
# while adoption happens (a report before the record exists gets no answer),
# then streams its answer to the last directory named and removes the stream
# before the turn settles.
screen idle
hook session_start {}
sleep 1000
hook session_start {}
sleep 1000
hook session_start {}
sleep 1000
hook session_start {}
sleep 1000
hook session_start {}
sleep 1000
hook session_start {}
hook agent_start {}
screen working
live the login bug is in the redirect
sleep 400
live the login bug is in the redirect, and the fixture hides it
sleep 4000
live
transcript {"type":"message","id":"u1","parentId":null,"message":{"role":"user","content":"where is the login bug","timestamp":1}}
transcript {"type":"message","id":"a1","parentId":"u1","message":{"role":"assistant","content":[{"type":"text","text":"the login bug is in the redirect, and the fixture hides it"}],"stopReason":"stop"}}
screen idle
hook agent_settled {"last_assistant_message":"the login bug is in the redirect, and the fixture hides it"}
sleep 600000
